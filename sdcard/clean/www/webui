#!/bin/sh
# HC1703L-WEBUI-SD  HC1703L Plus control panel, built on the base hack's "Augentix hacks UI". MIT License.
# The original stays on flash: /bak/hack/www/cgi-bin/webui. This file comes from the SD card and is
# bind-mounted over it in RAM (clean/www/kur.sh). "umount /tmp/hack/www/cgi-bin/webui" restores the original.
#
# Endpoints (the page is static; the browser fetches data and localises it, English or Turkish):
#   GET  webui                      page
#   GET  webui?s=status|snap|logs   machine-readable status | JPEG snapshot | plain-text logs
#   GET  webui?s=md                 motion settings (sensitivity, tracking, zones)
#   POST webui?c=COMMAND            command; replies "OK [code args]" or "ERR code".
#   POST webui?c=md_save&v=s1.t0.z0-0-3-10_6-2-3-4   save clean/md.conf; sensitivity and tracking apply at once, zones at the next boot
#                                   c= arriving by GET is IGNORED: a reload or restored tab never runs a command.
# Light, IR and PTZ commands are the same lines as in the original webui.
R=/tmp/mnt/mmc01/0
C=$R/clean
q=$QUERY_STRING
s=; c=
case "$q" in
  s=*) s=${q#s=}; s=${s%%&*} ;;
  c=*) c=${q#c=}; c=${c%%&*} ;;
esac
case "$s$c" in *[!A-Za-z0-9_]*) s=; c= ;; esac
v=
case "$q" in *"&v="*) v=${q#*&v=}; v=${v%%&*} ;; esac

text(){ echo "Content-type: text/plain; charset=utf-8"; echo "Cache-Control: no-store"; echo ""; }
md(){ set -- $(md5sum "$1" 2>/dev/null); echo "$1"; }
shp_read(){ awk '/^\[SHP_V2\]/{f=1;next} /^\[/{f=0} f&&/^strength *=/{gsub(/[^0-9]/,"");print;exit}' "$1" 2>/dev/null; }
h(){ httpclt get "http://127.0.0.1:8001/$1" >/dev/null 2>&1; }

find_mode(){
  a=$(md /tmp/dip_extend.ini)
  mode=unknown
  [ -n "$a" ] || return
  [ "$a" = "$(md /tmp/dip_extend_day.ini)" ] && { mode=day; return; }
  [ "$a" = "$(md /tmp/dip_extend_night.ini)" ] && { mode=night; return; }
  [ "$a" = "$(md /tmp/dip_extend_light.ini)" ] && mode=light
}

# Make p2pcam reload the day ISP file: night -> day -> auto.
reload_day(){
  dn=$(md /tmp/dip_extend_night.ini); dd=$(md /tmp/dip_extend_day.ini)
  h 'ircut?mode=night'
  i=0; while [ $i -lt 12 ] && [ "$(md /tmp/dip_extend.ini)" != "$dn" ]; do sleep 1; i=$((i+1)); done
  sleep 3
  h 'ircut?mode=day'
  i=0; while [ $i -lt 12 ] && [ "$(md /tmp/dip_extend.ini)" != "$dd" ]; do sleep 1; i=$((i+1)); done
  sleep 2
  h 'ircut?mode=auto'
}

# Lock older than 90 s counts as stale (a killed request cannot release it).
lock_take(){
  read u _ < /proc/uptime; u=${u%%.*}
  if ! mkdir /tmp/webui.lock 2>/dev/null; then
    t=; read t < /tmp/webui.lock/time 2>/dev/null
    case "$t" in ''|*[!0-9]*) t=0 ;; esac
    [ $((u - t)) -gt 90 ] || return 1
    rm -rf /tmp/webui.lock; mkdir /tmp/webui.lock 2>/dev/null || return 1
  fi
  echo $u > /tmp/webui.lock/time
}
lock_drop(){ rm -rf /tmp/webui.lock; }

# Synchronous on purpose: busybox httpd kills background jobs of a finished CGI.
sharpness(){
  v=$1
  lock_take || { echo "ERR sharp_busy"; return 1; }
  trap 'lock_drop' TERM HUP PIPE INT
  if [ -f $C/sensor_day.ini ]; then
    n=$C/sensor_day.new
    if sed "/^\[SHP_V2\]/,/^\[/ s/^strength = [0-9]*/strength = $v/" $C/sensor_day.ini > $n &&
       grep -q '^\[AE\]' $n && grep -q '^\[TE\]' $n && [ "$(shp_read $n)" = "$v" ] &&
       sync && mv -f $n $C/sensor_day.ini && sync; then :; else
      rm -f $n; lock_drop; echo "ERR sd_write"; return 1
    fi
  fi
  sed -i "/^\[SHP_V2\]/,/^\[/ s/^strength = [0-9]*/strength = $v/" /tmp/sensor_day.ini
  find_mode
  if [ "$mode" = day ]; then
    reload_day; lock_drop; find_mode
    echo "OK sharp_applied $v $mode"
  else
    lock_drop
    echo "OK sharp_saved $v"
  fi
}

next_stock(){
  [ -d $C ] || { echo "ERR no_sd"; return 1; }
  touch $C/DISABLE && rm -f $R/debug_cmd.sh && sync || { echo "ERR sd_write"; return 1; }
  echo "OK next_stock"
}

next_patched(){
  [ -f $C/debug_cmd.sh ] && [ -f $C/p2pcam.sqfs ] || { echo "ERR no_loader"; return 1; }
  rm -f $C/DISABLE $C/a1 $C/a2 $C/a3
  n=$R/debug_cmd.new
  rm -f $n
  if cp $C/debug_cmd.sh $n && sync && [ "$(md $C/debug_cmd.sh)" = "$(md $n)" ] && mv -f $n $R/debug_cmd.sh && sync; then
    echo "OK next_patched"
  else
    rm -f $n; echo "ERR sd_write"; return 1
  fi
}

# A reboot asked for from this page is not a failed boot: the patched build is clearly up, since it served the
# request. Clear the failure counters and make sure the loader is in place, otherwise a few setting changes in a
# row would look like a crash loop and drop the camera to stock. A stock boot is left alone: health.sh decides.
ready_for_reboot(){
  [ -f /tmp/p2pcam.clean.sqfs ] && [ ! -f $C/DISABLE ] || return 0
  rm -f $C/a1 $C/a2 $C/a3
  [ -f $R/debug_cmd.sh ] && return 0
  l=$R/debug_cmd.new
  if cp $C/debug_cmd.sh $l && sync && [ "$(md $C/debug_cmd.sh)" = "$(md $l)" ]; then mv -f $l $R/debug_cmd.sh; else rm -f $l; fi
  sync
}

# Motion settings live in clean/md.conf on the SD card. debug_cmd.sh applies them to RAM copies at boot,
# so nothing is written to flash. mdcfg validates the zones before the file is replaced.
tool(){ [ -x /tmp/mdcfg ] || { cp $C/bin/mdcfg /tmp/mdcfg && chmod 755 /tmp/mdcfg; }; [ -x /tmp/mdcfg ]; }
p2p_pid(){ ps | awk '/\/p2pcam\/p2pcam/ && !/awk/{print $1; exit}'; }
# Apply sensitivity and tracking to the running p2pcam, only on the patched build whose addresses we know (mdcfg
# checks them too). A zone change returns 1: p2pcam reads zones at boot, so the panel offers a reboot.
md_live(){
  [ -f /tmp/p2pcam.clean.sqfs ] || return 1
  tool || return 1
  [ "$(/tmp/mdcfg show /home/devParam.dat | grep '^zones=')" = "$(grep '^zones=' $C/md.conf)" ] || return 1
  pid=$(p2p_pid)
  [ -n "$pid" ] && [ "$(md /proc/$pid/exe)" = "$(cat $C/p2pcam.md5 2>/dev/null)" ] || return 1
  /tmp/mdcfg live "$pid" $C/md.conf
}
# Saved camera positions: clean/ptz.conf on the SD card, lines "1=x,y". Slots 1 to 4.
ptz_tool(){ [ -x /tmp/ptzpos ] || { cp $C/bin/ptzpos /tmp/ptzpos && chmod 755 /tmp/ptzpos; }; [ -x /tmp/ptzpos ]; }
ptz_save(){
  case "$v" in [1-4]) ;; *) echo "ERR invalid"; return 1 ;; esac
  ptz_tool || { echo "ERR no_sd"; return 1; }
  set -- $(/tmp/ptzpos get); [ -n "$2" ] || { echo "ERR ptz"; return 1; }
  { [ -f $C/ptz.conf ] && grep -v "^$v=" $C/ptz.conf; echo "$v=$1,$2"; } > /tmp/ptz.new
  if cp /tmp/ptz.new $C/ptz.tmp && sync && mv -f $C/ptz.tmp $C/ptz.conf && sync; then echo "OK"; else rm -f $C/ptz.tmp; echo "ERR sd_write"; fi
  rm -f /tmp/ptz.new
}
ptz_go(){
  case "$v" in [1-4]) ;; *) echo "ERR invalid"; return 1 ;; esac
  ptz_tool || { echo "ERR no_sd"; return 1; }
  p=$(awk -F= -v k="$v" '$1==k{print $2; exit}' $C/ptz.conf 2>/dev/null)
  [ -n "$p" ] || { echo "ERR empty"; return 1; }
  /tmp/ptzpos go ${p%,*} ${p#*,} && echo "OK" || echo "ERR ptz"
}
md_read(){
  sens=1; if [ -f $C/md.conf ]; then cat $C/md.conf; else tool && /tmp/mdcfg show /home/devParam.dat; echo "sensitivity=1"; fi
}
md_save(){
  case "$v" in ''|*[!a-z0-9._-]*) echo "ERR invalid"; return 1 ;; esac
  S=; T=; Z=
  for p in $(echo "$v" | tr . ' '); do
    case "$p" in
      s[012]) S=${p#s} ;;
      t[01])  T=${p#t} ;;
      z*)     Z=${p#z} ;;
      *) echo "ERR invalid"; return 1 ;;
    esac
  done
  [ -n "$S" ] && [ -n "$T" ] || { echo "ERR invalid"; return 1; }
  [ -d $C ] && tool || { echo "ERR no_sd"; return 1; }
  n=/tmp/md.conf.$$
  { echo "sensitivity=$S"; echo "tracking=$T"; echo "zones=$(echo "$Z" | tr '_-' ';,')"
    [ -f $C/md.conf ] && grep -E '^(motion|human)=' $C/md.conf; } > $n
  if ! /tmp/mdcfg apply /home/devParam.dat $n.out $n; then rm -f $n $n.out; echo "ERR invalid"; return 1; fi
  rm -f $n.out
  if cp $n $C/md.new && sync && mv -f $C/md.new $C/md.conf && sync; then rm -f $n; else rm -f $n $C/md.new; echo "ERR sd_write"; return 1; fi
  if md_live; then echo "OK md_live"; else ready_for_reboot; echo "OK md_saved"; fi
}

command(){
  case "$c" in
    day)   h 'ircut?mode=day' ;;
    night) h 'ircut?mode=night' ;;
    auto)  h 'ircut?mode=auto' ;;
    Won|wl_on)   gio -s 12 1 > /dev/null ;;
    Woff|wl_off) gio -s 12 0 > /dev/null ;;
    iron|ir_on)  gio -s 77 0 > /dev/null ;;
    iroff|ir_off) gio -s 77 1 > /dev/null ;;
    ptzl) /bin/ptz_test 1 ;;
    ptzr) /bin/ptz_test 2 ;;
    ptzu) /bin/ptz_test 3 ;;
    ptzd) /bin/ptz_test 4 ;;
    ptz0) /bin/ptz_test 0 ;;
    ptzlu) /bin/ptz_test 1 && sleep 0.2 && /bin/ptz_test 0
           /bin/ptz_test 3 && sleep 0.2 && /bin/ptz_test 0 ;;
    ptzld) /bin/ptz_test 1 && sleep 0.2 && /bin/ptz_test 0
           /bin/ptz_test 4 && sleep 0.2 && /bin/ptz_test 0 ;;
    ptzru) /bin/ptz_test 2 && sleep 0.2 && /bin/ptz_test 0
           /bin/ptz_test 3 && sleep 0.2 && /bin/ptz_test 0 ;;
    ptzrd) /bin/ptz_test 2 && sleep 0.2 && /bin/ptz_test 0
           /bin/ptz_test 4 && sleep 0.2 && /bin/ptz_test 0 ;;
    play)         h 'playaudio?file=/tmp/VOICE/NoId.wav' ;;
    wlon)         h 'whitelight?mode=on' ;;
    wlof)         h 'whitelight?mode=off' ;;
    irctrlnig)    h 'irctrl?mode=night' ;;
    irctrlday)    h 'irctrl?mode=day' ;;
    ircutonlyday) h 'ircut_only?mode=day' ;;
    ircutonlynig) h 'ircut_only?mode=night' ;;
    ircutnig)     h 'ircut?mode=night' ;;
    ircutday)     h 'ircut?mode=day' ;;
    redinfraon)   h 'redinfra?mode=on' ;;
    redinfraof)   h 'redinfra?mode=off' ;;
    sharp125|sharp140|sharp170) sharpness ${c#sharp}; return ;;
    next_stock)   next_stock; return ;;
    next_patched) next_patched; return ;;
    md_save)      md_save; return ;;
    ptz_save)     ptz_save; return ;;
    ptz_go)       ptz_go; return ;;
    reboot) ready_for_reboot
            ( sleep 1; sync; reboot ) </dev/null >/dev/null 2>&1 &
            echo "OK rebooting"; return ;;
    *) echo "ERR unknown"; return 1 ;;
  esac
  echo "OK"
}

status(){
  echo "time=$(date '+%Y-%m-%d %H:%M:%S')"
  read up _ < /proc/uptime; echo "uptime=${up%%.*}"
  [ -f /tmp/p2pcam.clean.sqfs ] && echo "build=patched" || echo "build=stock"
  if [ -f $C/DISABLE ]; then echo "next=stock_disabled"
  elif [ -f $R/debug_cmd.sh ]; then echo "next=patched"
  else echo "next=stock_pending"; fi
  find_mode; echo "mode=$mode"
  a=$(gio -g 12 2>/dev/null | awk '/gio.value/{print $3}'); echo "wl=$a"
  a=$(gio -g 77 2>/dev/null | awk '/gio.value/{print $3}'); [ "$a" = 0 ] && echo "ir=1" || echo "ir=0"
  if ptz_tool; then echo "ptz=$(/tmp/ptzpos get 2>/dev/null)"; [ -f $C/ptz.conf ] && sed 's/^/preset/' $C/ptz.conf; fi
  # mode is what the camera runs now; image is what was selected (0 auto, 1 day, 2 night)
  pid=$(p2p_pid); [ -n "$pid" ] && tool && echo "image=$(/tmp/mdcfg image "$pid" 2>/dev/null)"
  echo "sharpness=$(shp_read /tmp/sensor_day.ini)"
  awk '/^MemAvailable/{print "mem_kb=" $2}' /proc/meminfo
  top -b -n 1 2>/dev/null | awk '/^CPU:/{for(i=1;i<=NF;i++) if($(i+1)=="idle"){v=$i; sub(/%/,"",v); print "cpu=" 100-v; exit}}'
  awk 'NR==3{v=$4; sub(/\.$/,"",v); print "wifi=" v}' /proc/net/wireless
  if grep -q ' /tmp/mnt/mmc01/0 ' /proc/mounts; then
    df -k $R | awk 'NR==2{print "sd=" $3 "|" $2}'
    d=$(ls -1d $R/20[0-9][0-9]-* 2>/dev/null | tail -n 1)
    hh=$(ls -1d $d/[0-2][0-9] 2>/dev/null | tail -n 1)
    f=$(ls -1 $hh/*.mp4 2>/dev/null | tail -n 1)
    if [ -n "$f" ]; then echo "$f" | awk -F/ '{n=$NF; print "lastmotion=" substr(n,1,4) "-" substr(n,5,2) "-" substr(n,7,2) " " substr(n,10,2) ":" substr(n,12,2) ":" substr(n,14,2)}'
    else echo "lastmotion=none"; fi
    echo "bootlog=$(tail -n 1 $C/boot.log 2>/dev/null)"
  else
    echo "sd=none"
  fi
  echo "cloud_routes=$(route -n 2>/dev/null | grep -c '!')"
  echo "cloud_dns=$(awk '/^nameserver/{print $2;exit}' /etc/resolv.conf 2>/dev/null)"
  ps | grep -q '[m]o\.sh' && echo "recorder=1" || echo "recorder=0"
  [ -f /home/HACKP ] && echo "hack=persistent"
}

case "$s" in
  status) text; status; exit 0 ;;
  md) text; md_read; exit 0 ;;
  snap)
    f=/tmp/wsnap.$$.jpg
    httpclt getfile "http://127.0.0.1:8001/snapshot" $f >/dev/null 2>&1
    if [ -s $f ]; then echo "Content-type: image/jpeg"; echo "Cache-Control: no-store"; echo ""; cat $f
    else text; echo "no image"; fi
    rm -f $f; exit 0 ;;
  logs)
    text
    echo "== Boot log (clean/boot.log)"; tail -n 15 $C/boot.log 2>&1
    echo; echo "== Motion service (mo.log)"; tail -n 8 $R/mo.log 2>&1
    echo; echo "== minihack (/home/log.txt)"; tail -n 8 /home/log.txt 2>&1
    echo; echo "== p2pcam"; md5sum /p2pcam/p2pcam 2>&1; ps | grep '[p]2pcam/p2pcam'
    echo; echo "== Listening ports"; netstat -ltnu 2>/dev/null | grep -v '^Active'
    echo; echo "== Routes"; route -n 2>&1
    exit 0 ;;
esac

if [ -n "$c" ]; then
  text
  if [ "$REQUEST_METHOD" = POST ]; then command; else echo "ERR post_only"; fi
  exit 0
fi

echo "Content-type: text/html; charset=utf-8"
echo "Cache-Control: no-store"
echo ""
