function msg(s,c){var m=$('#msg');m.textContent=s;m.className=c||''}
function send(c){return fetch('webui?c='+c,{method:'POST',cache:'no-store'}).then(function(r){return r.text().then(function(x){return x.trim()})})}
function reply(r){
  var p=r.split(/\s+/);
  if(p[0]==='OK'){if(!p[1])return [t('OK'),'good'];return [t(p[1],p[2],p[3]),'good']}
  if(p[0]==='ERR')return [t('ERR_'+(p[1]||'unknown')),'bad'];
