  if(!was)msg(t('p_going',n));
  send((was?'ptz_save':'ptz_go')+'&v='+n).then(function(r){
    if(r==='OK')msg(t(was?'p_saved':'p_there',n),'good');else{var x=reply(r);msg(x[0],x[1])}
    status();
  },function(){msg(t('neterr',n),'bad')});
}});

// PTZ hold: commands are chained so "stop" can never overtake "move".
var chain=Promise.resolve(),held=null;
function ptz(c){chain=chain.then(function(){return send(c)}).catch(function(){})}
function release(){if(!held)return;held.classList.remove('on');held=null;ptz('ptz0')}
document.querySelectorAll('button[data-hold]').forEach(function(b){
  b.addEventListener('pointerdown',function(e){
    e.preventDefault();if(held)return;held=b;b.classList.add('on');
    try{b.setPointerCapture(e.pointerId)}catch(_){}
    ptz(b.dataset.hold);
  });
  ['pointerup','pointercancel','lostpointercapture'].forEach(function(ev){b.addEventListener(ev,release)});
  b.addEventListener('contextmenu',function(e){e.preventDefault()});
});
window.addEventListener('blur',release);
document.addEventListener('visibilitychange',function(){if(document.hidden)release()});

// Preview: next frame 1 s after the previous one loaded; paused while the tab is hidden.
var img=$('#preview'),open=true,waiting=false,timer=null;
function next(){clearTimeout(timer);if(!open||document.hidden||waiting)return;waiting=true;img.src='webui?s=snap&t='+Date.now()}
img.onload=function(){waiting=false;$('#pstate').textContent=t('pv_live')+' · '+new Date().toLocaleTimeString(lang==='tr'?'tr-TR':'en-GB');timer=setTimeout(next,1000)};
img.onerror=function(){waiting=false;$('#pstate').textContent=t('pv_fail');timer=setTimeout(next,3000)};
$('#ptoggle').onclick=function(){open=!open;this.textContent=t(open?'pv_stop':'pv_start');if(open)next();else{clearTimeout(timer);$('#pstate').textContent=t('pv_stopped')}};

// Status
var last=null;
function modeName(v){var m=t('m_'+(v.mode||'unknown'));return v.image==='0'?t('m_auto',m):m}
var ORDER=['build','next','mode','sharpness','cloud','recorder','lastmotion','sd','wifi','mem','cpu','uptime','time','hack','bootlog'];
function gb(kb){return (kb/1048576).toFixed(2).replace('.',lang==='tr'?',':'.')+' GB'}
function render(v){
  var dl=$('#status');dl.textContent='';
  function add(k,val,cls){var dt=document.createElement('dt');dt.textContent=t('k_'+k);var dd=document.createElement('dd');dd.textContent=val;if(cls)dd.className=cls;dl.appendChild(dt);dl.appendChild(dd)}
  ORDER.forEach(function(k){
    switch(k){
    case 'build':if(v.build)add(k,t(v.build==='patched'?'v_patched':'v_stock'),v.build==='patched'?'good':'bad');break;
    case 'next':if(v.next)add(k,t({patched:'v_next_patched',stock_disabled:'v_next_disabled',stock_pending:'v_next_pending'}[v.next]||v.next));break;
    case 'mode':if(v.mode)add(k,modeName(v));break;
    case 'sharpness':if(v.sharpness)add(k,v.sharpness);break;
    case 'cloud':if('cloud_routes' in v){var ok=+v.cloud_routes>=2&&v.cloud_dns==='127.0.0.1';add(k,ok?t('v_blocked',v.cloud_routes):t('v_open',v.cloud_routes,v.cloud_dns||'?'),ok?'good':'bad')}break;
    case 'recorder':if('recorder' in v)add(k,t(v.recorder==='1'?'v_running':'v_stopped'),v.recorder==='1'?'good':'bad');break;
    case 'lastmotion':if(v.lastmotion)add(k,v.lastmotion==='none'?t('v_none'):v.lastmotion);break;
    case 'sd':if(v.sd){if(v.sd==='none')add(k,t('v_nosd'),'bad');else{var s=v.sd.split('|');add(k,t('v_sd',gb(+s[0]),gb(+s[1]),Math.round(100*s[0]/s[1])))}}break;
    case 'wifi':if(v.wifi)add(k,v.wifi+' dBm');break;
    case 'mem':if(v.mem_kb)add(k,(v.mem_kb/1024).toFixed(1).replace('.',lang==='tr'?',':'.')+' MB');break;
    case 'cpu':if(v.cpu)add(k,t('v_cpu',v.cpu));break;
    case 'uptime':if(v.uptime){var u=+v.uptime,dd=Math.floor(u/86400),hh=Math.floor(u%86400/3600),mm=Math.floor(u%3600/60);add(k,(dd?dd+' '+t('d')+' ':'')+hh+' '+t('h')+' '+mm+' '+t('min'))}break;
    case 'time':if(v.time)add(k,v.time);break;
    case 'hack':if(v.hack)add(k,t('v_persistent'));break;
    case 'bootlog':if(v.bootlog)add(k,v.bootlog);break;
    }
  });
  document.querySelectorAll('button[data-k]').forEach(function(b){b.classList.toggle('on',b.dataset.k===v.sharpness)});
  ['wl','ir'].forEach(function(k){if(k in v){lit[k]=v[k]==='1';var b=$('#'+k);b.classList.toggle('on',lit[k]);b.setAttribute('aria-pressed',lit[k]?'true':'false')}});
  presetUi(v);
  var picked={'0':'auto','1':'day','2':'night'}[v.image]||v.mode;
  document.querySelectorAll('button[data-mode]').forEach(function(b){b.classList.toggle('on',b.dataset.mode===picked)});
  $('#badge').textContent=(v.build==='patched'?t('v_next_patched'):(lang==='tr'?'Stok':'Stock'))+' · '+modeName(v)+' · '+(v.time||'');
}
function status(){
  if(document.hidden)return;
  fetch('webui?s=status',{cache:'no-store'}).then(function(r){return r.text()}).then(function(x){
    var v={};x.split('\n').forEach(function(s){var i=s.indexOf('=');if(i>0)v[s.slice(0,i)]=s.slice(i+1)});
    last=v;render(v);
  }).catch(function(){$('#badge').textContent=t('unreachable')});
}
// Motion settings. Zones are x,y,w,h on a 10x10 grid over the preview.
var md={s:1,t:0,z:[]},editing=false,zb=$('#zonebox'),draft=null,start=null,gridOn=true;
try{gridOn=localStorage.getItem('hc_grid')!=='0'}catch(e){}
function drawMd(){
  document.querySelectorAll('[data-sens]').forEach(function(b){b.classList.toggle('on',+b.dataset.sens===md.s)});
  document.querySelectorAll('[data-track]').forEach(function(b){b.classList.toggle('on',+b.dataset.track===md.t)});
  $('#zinfo').textContent=md.z.length?t('z_n',md.z.length):t('z_all');
  $('#zedit').textContent=t(editing?'z_done':'z_edit');
  zb.textContent='';
  md.z.forEach(function(r,i){zb.appendChild(box(r,'zone',i))});
  // Outside edit mode the overlay is display only: it follows the zones and the user's show/hide choice.
  zb.hidden=!(editing||(gridOn&&md.z.length));
  zb.classList.toggle('view',!editing);
  var g=$('#zgrid');g.hidden=editing||!md.z.length;g.textContent=t(gridOn?'g_hide':'g_show');
}
function box(r,cls,i){var d=document.createElement('div');d.className=cls;if(i!==undefined)d.dataset.i=i;
  d.style.left=r[0]*10+'%';d.style.top=r[1]*10+'%';d.style.width=r[2]*10+'%';d.style.height=r[3]*10+'%';return d}
function cell(e){var b=zb.getBoundingClientRect();
  return [Math.max(0,Math.min(9,Math.floor(10*(e.clientX-b.left)/b.width))),Math.max(0,Math.min(9,Math.floor(10*(e.clientY-b.top)/b.height)))]}
function rect(a,b){var x=Math.min(a[0],b[0]),y=Math.min(a[1],b[1]);return [x,y,Math.abs(a[0]-b[0])+1,Math.abs(a[1]-b[1])+1]}
zb.addEventListener('pointerdown',function(e){
  e.preventDefault();
  if(e.target.classList.contains('zone')){md.z.splice(+e.target.dataset.i,1);drawMd();return}
  if(md.z.length>=25){msg(t('z_full'),'bad');return}
  start=cell(e);draft=box(rect(start,start),'zone draft');zb.appendChild(draft);
  try{zb.setPointerCapture(e.pointerId)}catch(_){}
});
zb.addEventListener('pointermove',function(e){
  if(!start)return;var r=rect(start,cell(e));
  draft.style.left=r[0]*10+'%';draft.style.top=r[1]*10+'%';draft.style.width=r[2]*10+'%';draft.style.height=r[3]*10+'%';
});
function endDraw(e){if(!start)return;var r=rect(start,cell(e));start=null;draft=null;md.z.push(r);drawMd()}
zb.addEventListener('pointerup',endDraw);
zb.addEventListener('pointercancel',function(){start=null;draft=null;drawMd()});
$('#zgrid').onclick=function(){gridOn=!gridOn;try{localStorage.setItem('hc_grid',gridOn?'1':'0')}catch(e){}drawMd()};
$('#zedit').onclick=function(){editing=!editing;$('#zhelp').hidden=!editing;drawMd();if(editing)$('#pvwrap').scrollIntoView({behavior:'smooth',block:'center'})};
$('#zclear').onclick=function(){md.z=[];drawMd()};
document.querySelectorAll('[data-sens]').forEach(function(b){b.onclick=function(){md.s=+b.dataset.sens;drawMd()}});
document.querySelectorAll('[data-track]').forEach(function(b){b.onclick=function(){md.t=+b.dataset.track;drawMd()}});
$('#mdsave').onclick=function(){
  var v='s'+md.s+'.t'+md.t+'.z'+md.z.map(function(r){return r.join('-')}).join('_');
  msg(t('md_saving'));
  fetch('webui?c=md_save&v='+v,{method:'POST',cache:'no-store'}).then(function(r){return r.text()}).then(function(x){
    x=x.trim();
    if(x.indexOf('OK')!==0){var y=reply(x);msg(y[0],y[1]);return}
    if(x==='OK md_live'){msg(t('md_applied'),'good');return}
    if(!confirm(t('c_md'))){msg(t('md_later'));return}
    return send('reboot').then(function(){msg(t('md_rebooting'),'good')});
  }).catch(function(){msg(t('neterr',t('md_save')),'bad')});
};
function loadMd(){
  fetch('webui?s=md',{cache:'no-store'}).then(function(r){return r.text()}).then(function(x){
    x.split('\n').forEach(function(l){var i=l.indexOf('=');if(i<1)return;var k=l.slice(0,i),v=l.slice(i+1);
      if(k==='sensitivity')md.s=+v||0;else if(k==='tracking')md.t=+v?1:0;
      else if(k==='zones')md.z=v?v.split(';').map(function(z){return z.split(',').map(Number)}):[]});
    drawMd();
  }).catch(function(){});
}
$('#logbtn').onclick=function(){
  var p=$('#logs');
  if(!p.hidden){p.hidden=true;this.textContent=t('logs_show');return}
  p.hidden=false;p.textContent=t('loading');this.textContent=t('logs_hide');
  fetch('webui?s=logs',{cache:'no-store'}).then(function(r){return r.text()}).then(function(x){p.textContent=x});
};
document.addEventListener('visibilitychange',function(){if(!document.hidden){status();next()}});
applyLang();status();loadMd();setInterval(status,5000);next();
})();
</script>
</body>
</html>
