#!/bin/sh
# HC1703L-GAL-V2  HC1703L Plus recordings gallery. MIT License.
# Event = motion clip (+ the snapshot taken by mo.sh, paired through the relative path in motion/mo_*.clip).
# Endpoints:
#   GET  gal                         page (static; data is fetched by JS)
#   GET  gal?s=list[&d=DAY]          status + days + events (text, | separated)
#   GET  gal?dl=1&d=&h=&f=           download a clip (the player uses this too)
#   POST gal?arm=0|1                 motion e-mail switch: writes <SD>/armed ("1"/"0") for an external mailer
#   POST gal?del=1&d=&h=&f=&p=       delete an event (clip and/or snapshot+clip link)
#   POST gal?rmday=DAY               delete all clips and snapshots of a day (never today)
# Replies: "OK ..." or "ERR code". arm/del/rmday arriving by GET are IGNORED: an old "gal?arm=0" opened from history cannot change anything.
# Stock /bin/sh: has arithmetic, no cut/tr/wc.
BASE=/tmp/mnt/mmc01/0
OUT=$BASE/motion
ARMF=$BASE/armed
q="$QUERY_STRING"

getp() {
  rest="$q"
  while [ -n "$rest" ]; do
    kv="${rest%%&*}"
    case "$rest" in *"&"*) rest="${rest#*&}";; *) rest="";; esac
    case "$kv" in "$1="*) echo "${kv#*=}"; return;; esac
  done
}
s=$(getp s); d=$(getp d); h=$(getp h); f=$(getp f); p=$(getp p)
dl=$(getp dl); arm=$(getp arm); del=$(getp del); rmday=$(getp rmday)

day_ok()  { case "$1" in 20[0-9][0-9]-[01][0-9]-[0-3][0-9]) return 0;; esac; return 1; }
hour_ok() { case "$1" in [0-2][0-9]) return 0;; esac; return 1; }
vid_ok()  { case "$1" in *..*|*/*|*[!A-Za-z0-9._-]*) return 1;; 20*.mp4) return 0;; esac; return 1; }
snap_ok() { case "$1" in *..*|*/*|*[!A-Za-z0-9._-]*) return 1;; mo_*.jpg) return 0;; esac; return 1; }
text() { echo "Content-type: text/plain; charset=utf-8"; echo "Cache-Control: no-store"; echo ""; }

# ---------- CLIP DOWNLOAD (GET, no side effects) ----------
if [ -n "$dl" ]; then
  if day_ok "$d" && hour_ok "$h" && vid_ok "$f" && [ -f "$BASE/$d/$h/$f" ]; then
    echo "Content-type: video/mp4"
    echo "Content-Disposition: attachment; filename=\"$f\""
    echo ""
    cat "$BASE/$d/$h/$f"
    exit 0
  fi
  text; echo "not found"; exit 0
fi

# ---------- LIST ----------
list() {
  lim=$1
  T=/tmp/gal.$$
  day_ok "$d" || d=
  {
    echo "#K"; grep -H . "$OUT"/mo_*.clip 2>/dev/null
    echo "#V"; ls -l "$BASE"/20[0-9][0-9]-*/[0-2][0-9]/*.mp4 2>/dev/null
    echo "#P"; ls -1 "$OUT"/mo_*.jpg 2>/dev/null
  } | awk -v day="$d" -v base="$BASE/" '
    BEGIN { bl = length(base) }
    /^#K$/ { sec = "K"; next }
    /^#V$/ { sec = "V"; next }
    /^#P$/ { sec = "P"; next }
    { sub(/\r$/, "") }
    sec == "K" {
      i = index($0, ":"); if (!i) next
      n = split(substr($0, 1, i - 1), a, "/"); ph = a[n]; sub(/\.clip$/, ".jpg", ph)
      c2p[substr($0, i + 1)] = ph; next
    }
    sec == "V" {
      sz = $5; pth = $NF
      if (substr(pth, 1, bl) != base) next
      rel = substr(pth, bl + 1); if (split(rel, a, "/") != 3) next
      dy = a[1]; hr = a[2]; fl = a[3]
      ph = c2p[rel]; if (ph != "") used[ph] = 1
      vc[dy]++; by[dy] += sz; tv++
      if (day == "" || day == dy)
        printf "E%s%s\tevent|%s|%s|%s|%.0f|%s\n", substr(fl, 1, 8), substr(fl, 10, 6), dy, hr, fl, sz, ph
      next
    }
    sec == "P" {
      n = split($0, a, "/"); ph = a[n]
      t = substr(ph, 4, 8); ss = substr(ph, 13, 6)
      dy = substr(t, 1, 4) "-" substr(t, 5, 2) "-" substr(t, 7, 2)
      pa[dy]++; tp++
      if (ph in used) next
      po[dy]++
      if (day == "" || day == dy)
        printf "E%s%s\tevent|%s|%s||0|%s\n", t, ss, dy, substr(ss, 1, 2), ph
      next
    }
    END {
      for (dy in vc) g[dy] = 1
      for (dy in pa) g[dy] = 1
      for (dy in g)
        printf "G%s\tday|%s|%d|%d|%d|%.0f\n", dy, dy, vc[dy] + po[dy], vc[dy], pa[dy], by[dy]
      printf "T\ttotal|%d|%d\n", tv, tp
    }' > $T
  a=; read a < "$ARMF" 2>/dev/null; [ "$a" = 0 ] || a=1
  echo "status|$a|$(df -k "$BASE" | awk 'NR==2{print $3 "|" $2}')|$(date +%Y-%m-%d)"
  grep '^T' $T | awk 'BEGIN{FS="\t"}{print $2}'
  grep '^G' $T | sort -r | awk 'BEGIN{FS="\t"}{print $2}'
  grep '^E' $T | sort -r | head -n "$lim" | awk 'BEGIN{FS="\t"}{print $2}'
  rm -f $T
}

if [ "$s" = list ]; then
  text
  if [ -n "$d" ]; then list 100000; else list 48; fi
  exit 0
fi

# ---------- CHANGING ACTIONS: POST only ----------
if [ -n "$arm$del$rmday" ]; then
  text
  if [ "$REQUEST_METHOD" != POST ]; then echo "ERR post_only"; exit 0; fi
  if [ -n "$arm" ]; then
    case "$arm" in 0|1) ;; *) echo "ERR invalid"; exit 0;; esac
    echo "$arm" > "$ARMF.new" && mv -f "$ARMF.new" "$ARMF" && sync && echo "OK $arm" || echo "ERR sd_write"
    exit 0
  fi
  if [ -n "$del" ]; then
    n=0
    if [ -n "$f" ]; then
      day_ok "$d" && hour_ok "$h" && vid_ok "$f" || { echo "ERR invalid"; exit 0; }
      rm -f "$BASE/$d/$h/$f" && n=$((n+1))
    fi
    if [ -n "$p" ]; then
      snap_ok "$p" || { echo "ERR invalid"; exit 0; }
      rm -f "$OUT/$p" "$OUT/${p%.jpg}.clip" && n=$((n+1))
    fi
    sync; echo "OK $n"; exit 0
  fi
  if [ -n "$rmday" ]; then
    day_ok "$rmday" || { echo "ERR invalid"; exit 0; }
    [ "$rmday" = "$(date +%Y-%m-%d)" ] && { echo "ERR today"; exit 0; }
    ymd=$rmday; ymd="${ymd%%-*}${ymd#????-}"; ymd="${ymd%-*}${ymd##*-}"
    rm -f "$BASE/$rmday"/[0-2][0-9]/*.mp4 "$OUT"/mo_${ymd}_*.jpg "$OUT"/mo_${ymd}_*.clip
    sync; echo "OK $rmday"; exit 0
  fi
fi

# ---------- PAGE ----------
echo "Content-type: text/html; charset=utf-8"
echo "Cache-Control: no-store"
echo ""
cat <<'EOT'
