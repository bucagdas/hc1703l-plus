    $('#pnote').textContent=t('p_note',(vt&&vt.video?vt.video.width+'×'+vt.video.height+' · ':''),(info.duration&&info.timescale?Math.round(info.duration/info.timescale)+' '+t('sec')+' · ':''));
  }).catch(function(e){if(e.name==='AbortError')return;area.textContent=t('play_err',e.message)});
}
applyLang();load();
