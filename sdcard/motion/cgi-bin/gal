var boxLoad=null;
function mp4box(){if(window.MP4Box)return Promise.resolve();if(boxLoad)return boxLoad;
  boxLoad=new Promise(function(ok,fail){var s=document.createElement('script');s.src='/mp4box.js';s.onload=ok;s.onerror=function(){boxLoad=null;fail(new Error('mp4box.js'))};document.head.appendChild(s)});return boxLoad}
function play(o){
  close();
  openDlg(dayName(o.g,true)+' · '+hms(o.f.slice(9,15))+' · '+mb(o.bytes),dlUrl(o));
  area.textContent=t('downloading',mb(o.bytes));
  var ac=new AbortController();abort=ac;
  Promise.all([mp4box(),fetch(dlUrl(o),{signal:ac.signal}).then(function(r){if(!r.ok)throw new Error('HTTP '+r.status);return r.arrayBuffer()})]).then(function(x){
    if(abort!==ac)return;
