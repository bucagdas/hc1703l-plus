// Player: the camera's MP4 does not open directly in Safari; mp4box.js remuxes it to fragmented MP4 in the browser.
function dlUrl(o){return 'gal?dl=1&d='+o.g+'&h='+o.h+'&f='+o.f}
var dlg=$('#player'),area=$('#parea'),url=null,abort=null;
function close(){if(abort)abort.abort();abort=null;var v=area.querySelector('video');if(v){v.pause();v.removeAttribute('src');v.load()}area.textContent='';if(url){URL.revokeObjectURL(url);url=null}if(dlg.open)dlg.close()}
$('#pclose').onclick=close;
dlg.addEventListener('cancel',function(e){e.preventDefault();close()});
dlg.addEventListener('click',function(e){if(e.target===dlg)close()});
function openDlg(title,dl){area.textContent='';$('#ptitle').textContent=title;var a=$('#pdl');a.hidden=!dl;if(dl)a.href=dl;$('#pnote').textContent='';if(!dlg.open)dlg.showModal()}
